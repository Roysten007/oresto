{
  "rules": {
    ".read": false,
    ".write": false,

    "platform_settings": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },

    "admins": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "prestataires": {
      ".read": "auth != null",
      ".indexOn": ["telephone", "email", "code_referral"],
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "referrals": {
      ".read": true,
      ".write": "auth != null"
    },

    "commissions": {
      ".read": "auth != null",
      ".indexOn": ["prestataire_id", "client_id", "mois"],
      "$commissionId": {
        ".write": "auth != null"
      }
    },

    "vendors": {
      ".read": true,
      ".indexOn": ["slug", "prestataire_id", "userId", "referral_code"],
      "$vendorId": {
        ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid || newData.child('userId').val() === auth.uid || root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "totalOrders": {
          ".write": true
        },
        "totalSales": {
          ".write": true
        },
        "revenue": {
          ".write": true
        }
      }
    },

    "products": {
      ".read": true,
      ".indexOn": ["vendorId", "category", "available"],
      "$productId": {
        ".write": "auth != null"
      }
    },

    "slugs": {
      ".read": true,
      "$slug": {
        ".write": "auth != null"
      }
    },

    "orders": {
      ".read": true,
      ".indexOn": ["vendorId", "clientId", "status", "date"],
      "$orderId": {
        ".write": true
      }
    },

    "messages": {
      "$orderId": {
        ".read": true,
        ".write": true,
        ".indexOn": ["timestamp"]
      }
    },

    "notifications": {
      "$target": {
        ".read": "auth != null",
        ".write": true
      }
    }
  }
}
