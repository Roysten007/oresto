{
  "rules": {
    ".read": false,
    ".write": false,

    "platform_settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (auth.uid === $uid && (!newData.hasChild('role') || newData.child('role').val() === data.child('role').val() || (data.child('role').val() !== 'admin' && newData.child('role').val() !== 'admin'))))"
      }
    },

    "prestataires": {
      ".read": "auth != null",
      ".indexOn": ["telephone", "email", "code_referral"],
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
      }
    },

    "referrals": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || !data.exists() || data.child('prestataire_id').val() === auth.uid)"
    },

    "commissions": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || data.child('prestataire_id').val() === auth.uid)",
      ".indexOn": ["prestataire_id", "client_id", "mois"],
      "$commissionId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },

    "vendors": {
      ".read": true,
      ".indexOn": ["slug", "prestataire_id", "userId", "referral_code"],
      "$vendorId": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (!data.exists() && newData.child('userId').val() === auth.uid) || (data.exists() && data.child('userId').val() === auth.uid))"
      }
    },

    "products": {
      ".read": true,
      ".indexOn": ["vendorId", "category", "available"],
      "$productId": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (!data.exists() && root.child('vendors').child(newData.child('vendorId').val()).child('userId').val() === auth.uid) || (data.exists() && root.child('vendors').child(data.child('vendorId').val()).child('userId').val() === auth.uid))"
      }
    },

    "slugs": {
      ".read": true,
      "$slug": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid || root.child('admins').child(auth.uid).exists())"
      }
    },

    "orders": {
      ".read": "auth != null",
      ".indexOn": ["vendorId", "clientId", "status", "date"],
      "$orderId": {
        ".write": "!data.exists() || (auth != null && (root.child('admins').child(auth.uid).exists() || root.child('vendors').child(data.child('vendorId').val()).child('userId').val() === auth.uid))"
      }
    },

    "messages": {
      "$orderId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["timestamp"]
      }
    },

    "notifications": {
      "$target": {
        ".read": "auth != null && (auth.uid === $target || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null"
      }
    },

    "survey_responses": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["createdAt", "city", "establishmentType", "wantsToTest"],
      "$responseId": {
        ".write": "(!data.exists() && newData.hasChildren(['establishmentType', 'city', 'createdAt'])) || (auth != null && root.child('admins').child(auth.uid).exists())",
        ".validate": "newData.hasChild('establishmentType') && newData.hasChild('city')"
      }
    }
  }
}
